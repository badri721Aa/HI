{
  "manifest_version": 3,
  "name": "Alhekma Live",
  "version": "1.0.0",
  "description": "Real-time platform companion — unread messages, news, and online friends at a glance.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://gvxnzgogfaifmsdkingq.supabase.co/*",
    "https://alhekma-cheating.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Alhekma Live"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://alhekma-cheating.vercel.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
