<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AnimalCompanyMenu</AssemblyName>
    <RootNamespace>AnimalCompanyMenu</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- FILL: point at your Animal Company install's Managed folder, e.g.
         C:\Program Files (x86)\Steam\steamapps\common\Animal Company\AnimalCompany_Data\Managed
         Pass it on the command line instead of editing this file:
           dotnet build -p:GameManagedPath="C:\...\AnimalCompany_Data\Managed" -p:BepInExCorePath="C:\...\BepInEx\core" -->
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">..\..\libs\game</GameManagedPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == ''">..\..\libs\bepinex</BepInExCorePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game assembly — FILL verify this is Mono (several MB). If it's a few KB, the
         game is IL2CPP and these references need to point at Il2CppInterop-generated
         interop assemblies instead; see README "If it's IL2CPP". -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- BepInEx core — copy 0Harmony.dll and BepInEx.dll out of <game>\BepInEx\core -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCorePath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCorePath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
