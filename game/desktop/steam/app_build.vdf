"AppBuild"
{
	"AppID" "YOUR_APP_ID"
	"Desc" "Deep Waters build"
	"ContentRoot" "../dist/"
	"BuildOutput" "./output/"
	"Depots"
	{
		"YOUR_WINDOWS_DEPOT_ID"
		{
			"FileMapping"
			{
				"LocalPath" "win-unpacked/*"
				"DepotPath" "."
				"recursive" "1"
			}
		}
		"YOUR_LINUX_DEPOT_ID"
		{
			"FileMapping"
			{
				"LocalPath" "linux-unpacked/*"
				"DepotPath" "."
				"recursive" "1"
			}
		}
	}
}
