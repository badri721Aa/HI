# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill it in.  NEVER share or commit your token.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED: Developer Portal -> your application -> Bot -> "Reset Token"
DISCORD_TOKEN=

# Run several bots from one process: comma-separated tokens (all get every module).
# For per-bot names/prefixes/modules use bots.json instead (see bots.example.json).
# BOT_TOKENS=token1,token2,token3

# Default command prefix (servers can change it with !setprefix)
PREFIX=!

# online | idle | dnd | invisible
# "invisible" makes the bot look offline, which moves it into the collapsed
# "Offline" part of the member list (big servers don't list offline members at all).
# It keeps working normally. Discord has no way to remove a bot from the list entirely.
# Once !setstatus or !setactivity has been used in Discord, the saved status and activity
# (data/db.json) override BOT_STATUS and BOT_ACTIVITY here; change them with !setstatus then.
BOT_STATUS=online

# Activity: "Type|text" with Type = Playing, Listening, Watching, Competing or Custom.
# Placeholders: {prefix} {commands} {servers} {name}. Not shown while invisible.
BOT_ACTIVITY=Listening|{prefix}help • {commands} commands

# Your Discord user ID(s) for owner-only commands (comma-separated).
# Leave empty to use the application's owner automatically.
OWNER_IDS=

# Leave empty: slash commands are then registered in every server the bot is in.
# Only for development: a SERVER ID the bot is in (Discord Developer Mode -> right-click
# the server icon -> Copy Server ID). Not the Application ID. A wrong ID gives "Unknown Guild".
DEV_GUILD_ID=

# Keep-alive web server. Render/Koyeb/etc. set PORT for you; set it yourself to
# enable the /health endpoint for uptime monitors.
# PORT=3000

# Where the JSON database lives
DATA_DIR=data

# Embed colour as hex without "#" (an unquoted # starts a comment in .env files)
EMBED_COLOR=5865F2

# Privileged intents. Turn them ON in the Developer Portal (Bot -> Privileged Gateway Intents).
# If they are not enabled there, the bot falls back to slash + @mention commands automatically.
MESSAGE_CONTENT_INTENT=true
MEMBERS_INTENT=true

# Restart the process if a bot stays disconnected for 10 minutes (needs pm2/Docker/a host that restarts it)
WATCHDOG=true

# Optional: free key from https://api.nasa.gov for the !apod command (otherwise the rate-limited DEMO_KEY is used)
# NASA_API_KEY=
