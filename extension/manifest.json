{
  "manifest_version": 3,
  "name": "AlhekmaTyper",
  "version": "1.0",
  "description": "Simulates human typing in Google Docs with variable speed, pauses, and typos",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://docs.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AlhekmaTyper"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
