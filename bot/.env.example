# ── Connection ────────────────────────────────────────────────
# Use a paid RPC (Helius, Triton, QuickNode) — the public endpoint rate-limits and is too slow to copy trades.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Defaults to RPC_URL with http→ws
# WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ── Wallets ───────────────────────────────────────────────────
# Base58 secret key (Phantom export) or a JSON byte array. USE A DEDICATED HOT WALLET, never your main one.
PRIVATE_KEY=
# Comma-separated wallets to copy
TARGET_WALLETS=

# true = simulate everything (quotes, positions, exits) without sending transactions
DRY_RUN=false

# ── Sizing ────────────────────────────────────────────────────
# fixed: always spend BUY_AMOUNT_SOL | ratio: spend COPY_RATIO × what the target spent
BUY_MODE=fixed
BUY_AMOUNT_SOL=0.05
COPY_RATIO=0.1
MAX_SOL_PER_TRADE=0.25
# Ignore target buys smaller than this (filters test buys / dust)
MIN_TARGET_BUY_SOL=0.1

# ── Risk limits ───────────────────────────────────────────────
DAILY_SOL_LIMIT=1
MAX_OPEN_POSITIONS=5
# SOL always left in the wallet for fees / rent
SOL_RESERVE=0.02
MAX_PRICE_IMPACT_PCT=15
# Buy again when the target adds to a token we already hold
ALLOW_REBUY=false
# Ignore target trades older than this (stale signals)
MAX_TX_AGE_SEC=30

# ── Exits ─────────────────────────────────────────────────────
# Sell the same fraction when the target sells
COPY_SELLS=true
# 0 disables each
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=40
MAX_HOLD_MINUTES=0
PRICE_CHECK_INTERVAL_SEC=10

# ── Execution ─────────────────────────────────────────────────
# Free tier; for api.jup.ag set JUPITER_API_URL=https://api.jup.ag/swap/v1 and JUPITER_API_KEY
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
# JUPITER_API_KEY=
BUY_SLIPPAGE_BPS=1500
SELL_SLIPPAGE_BPS=2000
PRIORITY_FEE_MAX_LAMPORTS=1000000
# Backup polling alongside the websocket feed (0 disables)
POLL_INTERVAL_SEC=5
DATA_DIR=./data
