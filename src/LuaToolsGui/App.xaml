<Application
    x:Class="LuaToolsGui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:LuaToolsGui"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Nosignal made by ATVR — forced black & white theme -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- B&W accent overrides: replace all color accents with white/gray -->
                <ResourceDictionary>
                    <Color x:Key="SystemAccentColor">#FFFFFF</Color>
                    <Color x:Key="SystemAccentColorLight1">#E0E0E0</Color>
                    <Color x:Key="SystemAccentColorLight2">#C0C0C0</Color>
                    <Color x:Key="SystemAccentColorLight3">#A0A0A0</Color>
                    <Color x:Key="SystemAccentColorDark1">#CCCCCC</Color>
                    <Color x:Key="SystemAccentColorDark2">#999999</Color>
                    <Color x:Key="SystemAccentColorDark3">#666666</Color>
                    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#C0C0C0" />
                    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#999999" />
                    <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#666666" />
                    <!-- Override navigation highlight to white-on-dark -->
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#111111" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                    <!-- App background: pure black -->
                    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#0A0A0A" />
                    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#111111" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#141414" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1A1A1A" />
                    <!-- Text: pure white -->
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#BBBBBB" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#888888" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#555555" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <local:StatusToBrushConverter x:Key="StatusToBrush" />
            <local:ImagePathToSourceConverter x:Key="ImagePathToSource" />
            <local:EqualityMultiConverter x:Key="EqualityMulti" />
            <local:MinHeightToVisibilityConverter x:Key="MinHeightToVis" />
            <local:FilterOptionDisplayConverter x:Key="FilterOptionDisplay" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
