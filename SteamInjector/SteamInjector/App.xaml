<Application x:Class="SteamInjector.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="BgColor">#0F0F12</Color>
    <Color x:Key="CardColor">#1F1F28</Color>
    <Color x:Key="Card2Color">#2A2A36</Color>
    <Color x:Key="BorderColor">#3A3A4A</Color>
    <Color x:Key="AccentColor">#6C5CE7</Color>
    <Color x:Key="Accent2Color">#00CEC9</Color>
    <Color x:Key="GreenColor">#00B894</Color>
    <Color x:Key="RedColor">#FF4757</Color>
    <Color x:Key="YellowColor">#FDCB6E</Color>
    <Color x:Key="TextColor">#E8E8F0</Color>
    <Color x:Key="DimColor">#8888AA</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="Card2Brush" Color="{StaticResource Card2Color}"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimColor}"/>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#1F1F28"/>
      <Setter Property="Width" Value="6"/>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Background" Value="#6C5CE7"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#7D6EF8"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#5A4BD0"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#3A3A4A"/><Setter Property="Foreground" Value="#666680"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
      <Setter Property="Background" Value="#2A2A36"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3A3A4A"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#1F1F28"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
      <Setter Property="Background" Value="#CC3344"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF4455"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#AA2233"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
      <Setter Property="Background" Value="#00A882"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#00C99A"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#008866"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DarkTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="#2A2A36"/>
      <Setter Property="Foreground" Value="#E8E8F0"/>
      <Setter Property="BorderBrush" Value="#3A3A4A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="#6C5CE7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True"><Setter Property="BorderBrush" Value="#6C5CE7"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#5A5A7A"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DarkCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8E8F0"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="DarkCombo" TargetType="ComboBox">
      <Setter Property="Background" Value="#2A2A36"/>
      <Setter Property="Foreground" Value="#E8E8F0"/>
      <Setter Property="BorderBrush" Value="#3A3A4A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="DarkListBox" TargetType="ListBox">
      <Setter Property="Background" Value="#1F1F28"/>
      <Setter Property="BorderBrush" Value="#3A3A4A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#E8E8F0"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="DarkListItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E8E8F0"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="{TemplateBinding Background}" BorderBrush="Transparent"
                    BorderThickness="0" CornerRadius="4" Margin="2,1">
              <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A2A36"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#362E5E"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
