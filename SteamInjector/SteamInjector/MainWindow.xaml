<Window x:Class="SteamInjector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamInjector — AppID &amp; Manifest Manager"
        Height="760" Width="1140" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F12" Foreground="#E8E8F0">

  <Window.Resources>
    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8888AA"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="4,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A2A36"/><Setter Property="Foreground" Value="#E8E8F0"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#362E5E"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
      <Setter Property="Background" Value="#1E1E30"/>
      <Setter Property="Foreground" Value="#6C5CE7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#161620" BorderBrush="#2A2A36" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,20,16,24">
          <TextBlock Text="⚡ SteamInjector" FontSize="17" FontWeight="Bold" Foreground="#6C5CE7"/>
          <TextBlock x:Name="TxtVersion" Text="v1.0.0" FontSize="11" Foreground="#555570" Margin="0,2,0,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Margin="12,0,12,12" Background="#1F1F2E" CornerRadius="8" Padding="12,8">
          <StackPanel>
            <TextBlock Text="STEAM STATUS" FontSize="10" FontWeight="Bold" Foreground="#555570" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="SteamDot" Width="8" Height="8" Fill="#FF4757" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtSteamStatus" Text="Not Running" FontSize="12" Foreground="#8888AA"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="8,0">
          <Button x:Name="BtnNavDash"     Content="🏠  Dashboard"      Style="{StaticResource NavBtnActive}" Click="Nav_Click" Tag="Dashboard"/>
          <Button x:Name="BtnNavGames"    Content="🎮  Game Browser"    Style="{StaticResource NavBtn}"       Click="Nav_Click" Tag="Games"/>
          <Button x:Name="BtnNavInject"   Content="💉  Inject Manifest" Style="{StaticResource NavBtn}"       Click="Nav_Click" Tag="Inject"/>
          <Button x:Name="BtnNavLua"      Content="🌙  Lua Config"      Style="{StaticResource NavBtn}"       Click="Nav_Click" Tag="Lua"/>
          <Button x:Name="BtnNavDepot"    Content="📦  Depot Config"    Style="{StaticResource NavBtn}"       Click="Nav_Click" Tag="Depot"/>
          <Button x:Name="BtnNavBatch"    Content="⚡  Batch Inject"    Style="{StaticResource NavBtn}"       Click="Nav_Click" Tag="Batch"/>
          <Button x:Name="BtnNavLog"      Content="📋  Log Terminal"    Style="{StaticResource NavBtn}"       Click="Nav_Click" Tag="Log"/>
          <Button x:Name="BtnNavSettings" Content="⚙️  Settings"         Style="{StaticResource NavBtn}"       Click="Nav_Click" Tag="Settings"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1">

      <!-- DASHBOARD -->
      <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
          <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,6"/>
          <TextBlock x:Name="TxtSteamPathDash" Text="Steam Path: (not detected)" FontSize="13" Foreground="#8888AA" Margin="0,0,0,18"/>
          <WrapPanel Orientation="Horizontal" Margin="0,0,0,24">
            <Border Background="#1F1F28" CornerRadius="12" Padding="20,16" Margin="0,0,12,12" Width="200">
              <StackPanel><TextBlock Text="🎮" FontSize="28"/><TextBlock x:Name="StatGames" Text="0" FontSize="30" FontWeight="Bold" Foreground="#6C5CE7" Margin="0,4,0,2"/><TextBlock Text="Games in DB" FontSize="12" Foreground="#8888AA"/></StackPanel>
            </Border>
            <Border Background="#1F1F28" CornerRadius="12" Padding="20,16" Margin="0,0,12,12" Width="200">
              <StackPanel><TextBlock Text="💉" FontSize="28"/><TextBlock x:Name="StatInjected" Text="0" FontSize="30" FontWeight="Bold" Foreground="#00CEC9" Margin="0,4,0,2"/><TextBlock Text="Injected Manifests" FontSize="12" Foreground="#8888AA"/></StackPanel>
            </Border>
            <Border Background="#1F1F28" CornerRadius="12" Padding="20,16" Margin="0,0,12,12" Width="200">
              <StackPanel><TextBlock Text="📂" FontSize="28"/><TextBlock x:Name="StatLibs" Text="0" FontSize="30" FontWeight="Bold" Foreground="#FDCB6E" Margin="0,4,0,2"/><TextBlock Text="Library Folders" FontSize="12" Foreground="#8888AA"/></StackPanel>
            </Border>
            <Border Background="#1F1F28" CornerRadius="12" Padding="20,16" Margin="0,0,12,12" Width="200">
              <StackPanel><TextBlock Text="⚡" FontSize="28"/><TextBlock x:Name="StatStatus" Text="OFFLINE" FontSize="22" FontWeight="Bold" Foreground="#FF4757" Margin="0,4,0,2"/><TextBlock Text="Steam Running" FontSize="12" Foreground="#8888AA"/></StackPanel>
            </Border>
          </WrapPanel>
          <TextBlock Text="Library Folders" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,0,8"/>
          <ListBox x:Name="ListLibs" Height="140" Style="{StaticResource DarkListBox}">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource DarkListItem}"/></ListBox.ItemContainerStyle>
          </ListBox>
          <WrapPanel Margin="0,16,0,0">
            <Button Content="🔄 Refresh Status" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
            <Button Content="▶ Start Steam" Style="{StaticResource GreenBtn}" Margin="0,0,8,0" Click="BtnStartSteam_Click"/>
            <Button Content="⏹ Kill Steam" Style="{StaticResource DangerBtn}" Margin="0,0,8,0" Click="BtnKillSteam_Click"/>
            <Button Content="🔁 Restart Steam" Style="{StaticResource SecondaryBtn}" Click="BtnRestartSteam_Click"/>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- GAME BROWSER -->
      <Grid x:Name="PageGames" Visibility="Collapsed" Margin="28,24,28,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Game Browser" FontSize="22" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" x:Name="TxtGameCount" Text="0 games" FontSize="12" Foreground="#8888AA" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,4"/>
        <Grid Grid.Row="1" Margin="0,8,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="TxtSearch" Style="{StaticResource DarkTextBox}" TextChanged="TxtSearch_TextChanged"/>
          <ComboBox Grid.Column="1" x:Name="CmbGenre" Style="{StaticResource DarkCombo}" Margin="8,0,0,0" SelectionChanged="CmbGenre_SelectionChanged"/>
          <CheckBox Grid.Column="2" x:Name="ChkSelectedOnly" Content="Selected only" Style="{StaticResource DarkCheckBox}" Margin="10,0,0,0" VerticalAlignment="Center" Checked="ChkSelectedOnly_Changed" Unchecked="ChkSelectedOnly_Changed"/>
        </Grid>
        <Border Grid.Row="2" Background="#161620" CornerRadius="8" BorderBrush="#2A2A36" BorderThickness="1">
          <ListBox x:Name="ListGames" Style="{StaticResource DarkListBox}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="3,1"><ContentPresenter/></Border>
                      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#252535"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="#E8E8F0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="{Binding AppId}" FontSize="12" Foreground="#6C5CE7" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding Genre}" FontSize="11" Foreground="#8888AA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  <Border Grid.Column="4" CornerRadius="4" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border"><Setter Property="Background" Value="#1A2A1A"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsInjected}" Value="True"><Setter Property="Background" Value="#1A3A1A"/></DataTrigger></Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock"><Setter Property="Text" Value="Not Injected"/><Setter Property="Foreground" Value="#557755"/>
                          <Style.Triggers><DataTrigger Binding="{Binding IsInjected}" Value="True"><Setter Property="Text" Value="✓ Injected"/><Setter Property="Foreground" Value="#00B894"/></DataTrigger></Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button Content="☑ Select All" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Click="BtnSelectAll_Click"/>
            <Button Content="☐ Clear All" Style="{StaticResource SecondaryBtn}" Click="BtnClearAll_Click"/>
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="TxtSelected" Text="0 selected" Foreground="#8888AA" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="BtnInjectSelected" Content="💉 Inject Selected" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="BtnInjectSelected_Click"/>
            <Button x:Name="BtnRemoveSelected" Content="🗑 Remove Selected" Style="{StaticResource DangerBtn}" Click="BtnRemoveSelected_Click"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- INJECT MANIFEST -->
      <ScrollViewer x:Name="PageInject" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="680">
          <TextBlock Text="Inject Manifest" FontSize="22" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,18"/>
          <TextBlock Text="AppID" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtInjectAppId" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>
          <TextBlock Text="Game Name" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtInjectName" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>
          <TextBlock Text="Install Directory Name (optional)" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtInjectInstallDir" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>
          <TextBlock Text="State Flags" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <ComboBox x:Name="CmbStateFlags" Style="{StaticResource DarkCombo}" Margin="0,0,0,12">
            <ComboBoxItem Content="4 — Installed" IsSelected="True"/>
            <ComboBoxItem Content="6 — Download Required"/>
            <ComboBoxItem Content="516 — Fully Installed (with DLCs)"/>
          </ComboBox>
          <TextBlock Text="Target Library Folder" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <ComboBox x:Name="CmbInjectLibrary" Style="{StaticResource DarkCombo}" Margin="0,0,0,16"/>
          <CheckBox x:Name="ChkGenerateLua" Content="Also generate Lua config (.lua)" Style="{StaticResource DarkCheckBox}" Margin="0,0,0,8"/>
          <StackPanel x:Name="PanelLuaOutput" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="Lua Output Directory" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="TxtLuaOutDir" Style="{StaticResource DarkTextBox}"/>
              <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="BtnBrowseLuaDir_Click"/>
            </Grid>
          </StackPanel>
          <Button Content="💉  Inject Now" Style="{StaticResource PrimaryBtn}" Width="200" HorizontalAlignment="Left" Height="40" FontSize="14" Click="BtnInjectNow_Click"/>
          <Border Margin="0,16,0,0" Background="#1F1F28" CornerRadius="8" Padding="16">
            <TextBox x:Name="TxtInjectResult" IsReadOnly="True" Background="Transparent" Foreground="#00CEC9" BorderThickness="0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Height="80"/>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- LUA CONFIG -->
      <ScrollViewer x:Name="PageLua" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="680">
          <TextBlock Text="Lua Config Generator" FontSize="22" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,18"/>
          <TextBlock Text="AppID" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtLuaAppId" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>
          <TextBlock Text="Game Name" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtLuaName" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>
          <TextBlock Text="Depot IDs (comma-separated, optional)" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtLuaDepots" Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"/>
          <TextBlock Text="Output Directory" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="TxtLuaDir" Style="{StaticResource DarkTextBox}"/>
            <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="BtnBrowseLuaDir2_Click"/>
          </Grid>
          <Button Content="🌙  Generate Lua" Style="{StaticResource PrimaryBtn}" Width="200" HorizontalAlignment="Left" Height="40" FontSize="14" Click="BtnGenLua_Click"/>
          <TextBlock Text="Preview:" FontSize="13" Foreground="#8888AA" Margin="0,16,0,6"/>
          <Border Background="#161620" CornerRadius="8" Padding="16">
            <TextBox x:Name="TxtLuaPreview" IsReadOnly="True" Background="Transparent" Foreground="#00CEC9" BorderThickness="0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Height="220"/>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- DEPOT CONFIG -->
      <ScrollViewer x:Name="PageDepot" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="680">
          <TextBlock Text="Depot Configuration" FontSize="22" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,18"/>
          <TextBlock Text="AppID" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtDepotAppId" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>
          <TextBlock Text="Game Name" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtDepotName" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>
          <TextBlock Text="Depots (format: DepotID=ManifestID, one per line)" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtDepots" Style="{StaticResource DarkTextBox}" Height="120" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12" FontFamily="Consolas"/>
          <TextBlock Text="Branch / Build ID" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtBuildId" Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"/>
          <TextBlock Text="Target Library Folder" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <ComboBox x:Name="CmbDepotLibrary" Style="{StaticResource DarkCombo}" Margin="0,0,0,16"/>
          <Button Content="📦  Generate &amp; Inject with Depots" Style="{StaticResource PrimaryBtn}" Width="280" HorizontalAlignment="Left" Height="40" FontSize="14" Click="BtnInjectDepot_Click"/>
          <Border Margin="0,16,0,0" Background="#1F1F28" CornerRadius="8" Padding="16">
            <TextBox x:Name="TxtDepotResult" IsReadOnly="True" Background="Transparent" Foreground="#00CEC9" BorderThickness="0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Height="100"/>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- BATCH INJECT -->
      <Grid x:Name="PageBatch" Visibility="Collapsed" Margin="28,24,28,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Batch Inject" FontSize="22" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,6"/>
        <Grid Grid.Row="1" Margin="0,12,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Target Library Folder:" FontSize="13" Foreground="#8888AA" VerticalAlignment="Center"/>
          <ComboBox Grid.Column="1" x:Name="CmbBatchLibrary" Style="{StaticResource DarkCombo}" Width="360" Margin="8,0,0,0"/>
        </Grid>
        <Border Grid.Row="2" Background="#161620" CornerRadius="8" BorderBrush="#2A2A36" BorderThickness="1">
          <ListBox x:Name="ListBatch" Style="{StaticResource DarkListBox}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="3,1"><ContentPresenter/></Border>
                      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#252535"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="6,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="#E8E8F0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding AppId}" FontSize="12" Foreground="#6C5CE7" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding Genre}" FontSize="11" Foreground="#8888AA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ProgressBar x:Name="BatchProgress" Height="6" Maximum="100" Value="0" Background="#2A2A36" Foreground="#6C5CE7" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
            <CheckBox x:Name="ChkBatchLua" Content="Generate Lua" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="BtnBatchInject" Content="⚡ Batch Inject All Selected" Style="{StaticResource PrimaryBtn}" Click="BtnBatchInject_Click" Height="38"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- LOG TERMINAL -->
      <Grid x:Name="PageLog" Visibility="Collapsed" Margin="28,24,28,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Log Terminal" FontSize="22" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,14"/>
        <Border Grid.Row="1" Background="#0A0A10" CornerRadius="8" BorderBrush="#2A2A36" BorderThickness="1">
          <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Padding="4">
            <TextBox x:Name="TxtLog" IsReadOnly="True" Background="Transparent" Foreground="#00CEC9" BorderThickness="0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
          </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="🗑 Clear Log" Style="{StaticResource SecondaryBtn}" Click="BtnClearLog_Click"/>
        </StackPanel>
      </Grid>

      <!-- SETTINGS -->
      <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="640">
          <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,18"/>
          <TextBlock Text="Steam Path" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSteamPath" Style="{StaticResource DarkTextBox}"/>
            <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="BtnBrowseSteam_Click"/>
            <Button Grid.Column="2" Content="🔍 Auto-Detect" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" Click="BtnAutoDetect_Click"/>
          </Grid>
          <TextBlock x:Name="TxtSteamPathStatus" Text="" FontSize="11" Foreground="#00B894" Margin="0,4,0,16"/>
          <TextBlock Text="Default Lua Output Directory" FontSize="13" Foreground="#8888AA" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="TxtDefaultLuaDir" Style="{StaticResource DarkTextBox}"/>
            <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="BtnBrowseDefaultLua_Click"/>
          </Grid>
          <Button Content="💾  Save Settings" Style="{StaticResource GreenBtn}" Width="180" HorizontalAlignment="Left" Height="38" FontSize="13" Click="BtnSaveSettings_Click" Margin="0,0,0,8"/>
          <TextBlock x:Name="TxtSettingsStatus" Text="" FontSize="12" Foreground="#00B894"/>
          <Border Margin="0,24,0,0" Background="#1F1F28" CornerRadius="8" Padding="16">
            <StackPanel>
