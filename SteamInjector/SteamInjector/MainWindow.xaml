<Window x:Class="SteamInjector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamInjector" Height="780" Width="1160"
        MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0F" Foreground="#E0E0F0">

  <Window.Resources>

    <!-- Round button template -->
    <ControlTemplate x:Key="RoundBtnTpl" TargetType="Button">
      <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
              Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="bd" Property="Opacity" Value="0.60"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Background"      Value="#6C5CE7"/>
      <Setter Property="Foreground"      Value="#FFF"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="Padding"         Value="16,8"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"        Value="{StaticResource RoundBtnTpl}"/>
    </Style>
    <Style x:Key="SecondaryBtn" TargetType="Button">
      <Setter Property="Background"      Value="#252535"/>
      <Setter Property="Foreground"      Value="#B8B8D0"/>
      <Setter Property="FontWeight"      Value="Normal"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="Padding"         Value="14,7"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"        Value="{StaticResource RoundBtnTpl}"/>
    </Style>
    <Style x:Key="GreenBtn" TargetType="Button">
      <Setter Property="Background"      Value="#00B894"/>
      <Setter Property="Foreground"      Value="#FFF"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="Padding"         Value="14,7"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"        Value="{StaticResource RoundBtnTpl}"/>
    </Style>
    <Style x:Key="DangerBtn" TargetType="Button">
      <Setter Property="Background"      Value="#D63031"/>
      <Setter Property="Foreground"      Value="#FFF"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="Padding"         Value="14,7"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"        Value="{StaticResource RoundBtnTpl}"/>
    </Style>
    <Style x:Key="BlueBtn" TargetType="Button">
      <Setter Property="Background"      Value="#0984E3"/>
      <Setter Property="Foreground"      Value="#FFF"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="Padding"         Value="14,7"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"        Value="{StaticResource RoundBtnTpl}"/>
    </Style>
    <Style x:Key="SmallAddBtn" TargetType="Button">
      <Setter Property="Background"      Value="#6C5CE7"/>
      <Setter Property="Foreground"      Value="#FFF"/>
      <Setter Property="FontWeight"      Value="Bold"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Padding"         Value="10,4"/>
      <Setter Property="Width"           Value="62"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"        Value="{StaticResource RoundBtnTpl}"/>
    </Style>

    <!-- Nav buttons -->
    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background"                  Value="Transparent"/>
      <Setter Property="Foreground"                  Value="#666688"/>
      <Setter Property="BorderThickness"             Value="0"/>
      <Setter Property="Padding"                     Value="14,10"/>
      <Setter Property="FontSize"                    Value="13"/>
      <Setter Property="HorizontalContentAlignment"  Value="Left"/>
      <Setter Property="Cursor"                      Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                    Margin="4,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#22222E"/>
                <Setter Property="Foreground" Value="#D0D0F0"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#30285A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
      <Setter Property="Background" Value="#1C1C2E"/>
      <Setter Property="Foreground" Value="#7C6CF7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Dark TextBox -->
    <Style x:Key="DarkTxt" TargetType="TextBox">
      <Setter Property="Background"      Value="#161622"/>
      <Setter Property="Foreground"      Value="#E0E0F0"/>
      <Setter Property="CaretBrush"      Value="#E0E0F0"/>
      <Setter Property="BorderBrush"     Value="#32324A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="10,7"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="#6C5CE7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark ComboBox -->
    <Style x:Key="DarkCombo" TargetType="ComboBox">
      <Setter Property="Background"      Value="#161622"/>
      <Setter Property="Foreground"      Value="#E0E0F0"/>
      <Setter Property="BorderBrush"     Value="#32324A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="10,7"/>
      <Setter Property="FontSize"        Value="13"/>
    </Style>

    <!-- Dark CheckBox -->
    <Style x:Key="DarkCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#B0B0CC"/>
      <Setter Property="FontSize"   Value="13"/>
    </Style>

    <!-- ListBox -->
    <Style x:Key="DarkList" TargetType="ListBox">
      <Setter Property="Background"      Value="#111118"/>
      <Setter Property="BorderBrush"     Value="#222232"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground"      Value="#E0E0F0"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style x:Key="DarkListItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E0E0F0"/>
      <Setter Property="Padding"    Value="4,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                    Margin="2,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#22223A"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2A265A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ── Sidebar ── -->
    <Border Grid.Column="0" Background="#111118" BorderBrush="#1E1E2E" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Logo -->
        <StackPanel DockPanel.Dock="Top" Margin="16,18,16,20">
          <TextBlock Text="⚡ SteamInjector" FontSize="16" FontWeight="Bold" Foreground="#7C6CF7"/>
          <TextBlock x:Name="TxtVersion"   Text="v2.0" FontSize="10" Foreground="#44445A" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Status panel -->
        <Border DockPanel.Dock="Bottom" Margin="10,0,10,10"
                Background="#191920" CornerRadius="8" Padding="10,8">
          <StackPanel>
            <TextBlock Text="BACKEND" FontSize="9" FontWeight="Bold" Foreground="#44445A" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Ellipse x:Name="BackendDot" Width="7" Height="7" Fill="#FF4757"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtBackendStatus" Text="Offline" FontSize="11"
                         Foreground="#FF4757" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Text="STEAM" FontSize="9" FontWeight="Bold" Foreground="#44445A" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Ellipse x:Name="SteamDot" Width="7" Height="7" Fill="#FF4757"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtSteamStatus" Text="Not Running" FontSize="11"
                         Foreground="#666688"/>
            </StackPanel>

            <TextBlock Text="MILLENNIUM" FontSize="9" FontWeight="Bold" Foreground="#44445A" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="MillDot" Width="7" Height="7" Fill="#FF4757"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtMillStatus" Text="Not detected" FontSize="11"
                         Foreground="#666688" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Nav -->
        <StackPanel DockPanel.Dock="Top" Margin="6,0">
          <Button x:Name="BtnNavAdd"      Content="➕  Add Games"      Style="{StaticResource NavBtnActive}" Click="Nav_Click" Tag="Add"/>
          <Button x:Name="BtnNavLibrary"  Content="📚  My Library"     Style="{StaticResource NavBtn}"       Click="Nav_Click" Tag="Library"/>
          <Button x:Name="BtnNavTools"    Content="🔧  Manual Tools"   Style="{StaticResource NavBtn}"       Click="Nav_Click" Tag="Tools"/>
          <Button x:Name="BtnNavLog"      Content="📋  Log"            Style="{StaticResource NavBtn}"       Click="Nav_Click" Tag="Log"/>
          <Button x:Name="BtnNavSettings" Content="⚙️  Settings"       Style="{StaticResource NavBtn}"       Click="Nav_Click" Tag="Settings"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ── Content ── -->
    <Grid Grid.Column="1">

      <!-- ╔══════════════════════════════════════════════╗ -->
      <!-- ║  ADD GAMES PAGE                             ║ -->
      <!-- ╚══════════════════════════════════════════════╝ -->
      <Grid x:Name="PageAdd" Margin="24,20,24,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <!-- title -->
          <RowDefinition Height="Auto"/>
          <!-- backend banner -->
          <RowDefinition Height="Auto"/>
          <!-- search bar + stats -->
          <RowDefinition Height="*"/>
          <!-- results list -->
          <RowDefinition Height="Auto"/>
          <!-- action bar -->
        </Grid.RowDefinitions>

        <!-- Title row -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
          <TextBlock Text="Add Games" FontSize="22" FontWeight="Bold" Foreground="#E0E0F0"
                     VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="Mode:" FontSize="12" Foreground="#666688" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbMode" Style="{StaticResource DarkCombo}" Width="90"
                      SelectionChanged="CmbMode_SelectionChanged" Padding="6,5">
              <ComboBoxItem Content="Bst" IsSelected="True"/>
              <ComboBoxItem Content="Custom"/>
            </ComboBox>
            <CheckBox x:Name="ChkFastFetch" Content="FastFetch" Style="{StaticResource DarkCheck}"
                      Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
          </StackPanel>
        </Grid>

        <!-- Backend banner -->
        <Border x:Name="BackendBanner" Grid.Row="1" CornerRadius="8" Padding="12,8"
                Margin="0,0,0,12" Background="#1A1014" BorderBrush="#5A1A24" BorderThickness="1"
                Visibility="Visible">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="⚠" FontSize="14" Foreground="#FF6B81" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtBannerMsg"
                         Text="SteamAutoCrack backend is offline. Set its path in Settings and launch it."
                         Foreground="#FF6B81" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Launch" Style="{StaticResource DangerBtn}" Padding="10,4"
                      FontSize="12" Click="BtnLaunchBackend_Click" Margin="0,0,8,0"/>
              <Button Content="🔄" Style="{StaticResource SecondaryBtn}" Padding="8,4"
                      FontSize="12" Click="BtnCheckBackend_Click" ToolTip="Re-check backend"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Search + db label -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TxtSearch" Style="{StaticResource DarkTxt}" FontSize="14"
                   TextChanged="TxtSearch_Changed"
                   Tag="Search game name or AppID…"/>
          <TextBlock Grid.Column="1" x:Name="TxtDbInfo" Text="DB not loaded"
                     FontSize="11" Foreground="#44445A" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>

        <!-- Results -->
        <Border Grid.Row="3" Background="#111118" CornerRadius="8"
                BorderBrush="#1E1E30" BorderThickness="1">
          <ListBox x:Name="ListResults" Style="{StaticResource DarkList}"
                   BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource DarkListItem}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="6,5" MinHeight="34">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                  </Grid.ColumnDefinitions>

                  <!-- Name -->
                  <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                             Foreground="#E0E0F0" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>

                  <!-- AppID -->
                  <TextBlock Grid.Column="1" Text="{Binding AppId}" FontSize="11"
                             Foreground="#6C5CE7" VerticalAlignment="Center"
                             HorizontalAlignment="Center"/>

                  <!-- Status text -->
                  <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                             Foreground="{Binding StatusColor}" VerticalAlignment="Center"
                             Margin="4,0" MinWidth="200" TextTrimming="CharacterEllipsis"/>

                  <!-- Add / Cancel button -->
                  <Button Grid.Column="3" Content="{Binding BtnLabel}"
                          IsEnabled="{Binding BtnEnabled}"
                          Style="{StaticResource SmallAddBtn}"
                          Background="{Binding BtnColor}"
                          Click="BtnAddItem_Click"
                          Tag="{Binding}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- Action bar -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal">
            <Button Content="✅ Add All Selected" Style="{StaticResource PrimaryBtn}"
                    Click="BtnAddSelected_Click" Height="34" Margin="0,0,8,0"/>
            <Button Content="☑ Select All"        Style="{StaticResource SecondaryBtn}"
                    Click="BtnSelAll_Click"       Height="34" Margin="0,0,8,0"/>
            <Button Content="☐ Clear"              Style="{StaticResource SecondaryBtn}"
                    Click="BtnSelNone_Click"       Height="34"/>
          </StackPanel>

          <TextBlock Grid.Column="1" x:Name="TxtSelCount"
                     Text="" FontSize="12" Foreground="#666688"
                     VerticalAlignment="Center" HorizontalAlignment="Center"/>

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Content="🔄 Refresh Steam" Style="{StaticResource SecondaryBtn}"
                    Click="BtnRefreshSteam_Click" Height="34" Margin="0,0,8,0"/>
            <Button Content="▶ Start Steam"    Style="{StaticResource GreenBtn}"
                    Click="BtnStartSteam_Click" Height="34"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ╔══════════════════════════════════════════════╗ -->
      <!-- ║  LIBRARY PAGE                               ║ -->
      <!-- ╚══════════════════════════════════════════════╝ -->
      <Grid x:Name="PageLibrary" Visibility="Collapsed" Margin="24,20,24,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="My Library" FontSize="22" FontWeight="Bold"
                   Foreground="#E0E0F0" Margin="0,0,0,12"/>

        <!-- Stats strip -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12" Orientation="Horizontal">
          <Border Background="#1A1A26" CornerRadius="8" Padding="16,10" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🎮 " FontSize="14"/>
              <TextBlock x:Name="StatGames"     Text="0" FontSize="18" FontWeight="Bold" Foreground="#6C5CE7" Margin="2,0,4,0" VerticalAlignment="Center"/>
              <TextBlock Text="in DB" FontSize="11" Foreground="#666688" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Background="#1A1A26" CornerRadius="8" Padding="16,10" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="✅ " FontSize="14"/>
              <TextBlock x:Name="StatLoaded"    Text="0" FontSize="18" FontWeight="Bold" Foreground="#00B894" Margin="2,0,4,0" VerticalAlignment="Center"/>
              <TextBlock Text="loaded via backend" FontSize="11" Foreground="#666688" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Background="#1A1A26" CornerRadius="8" Padding="16,10" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="💉 " FontSize="14"/>
              <TextBlock x:Name="StatAcf"       Text="0" FontSize="18" FontWeight="Bold" Foreground="#00CEC9" Margin="2,0,4,0" VerticalAlignment="Center"/>
              <TextBlock Text="ACF manifests"  FontSize="11" Foreground="#666688" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Background="#1A1A26" CornerRadius="8" Padding="16,10" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🌙 " FontSize="14"/>
              <TextBlock x:Name="StatLua"       Text="0" FontSize="18" FontWeight="Bold" Foreground="#0984E3" Margin="2,0,4,0" VerticalAlignment="Center"/>
              <TextBlock Text="stplug-in scripts" FontSize="11" Foreground="#666688" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Background="#1A1A26" CornerRadius="8" Padding="16,10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="📂 " FontSize="14"/>
              <TextBlock x:Name="StatLibs"      Text="0" FontSize="18" FontWeight="Bold" Foreground="#FDCB6E" Margin="2,0,4,0" VerticalAlignment="Center"/>
              <TextBlock Text="library folders" FontSize="11" Foreground="#666688" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </WrapPanel>

        <!-- Library folders -->
        <Grid Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Steam Library Folders" FontSize="13" FontWeight="SemiBold"
                     Foreground="#B0B0CC" Margin="0,0,0,6"/>
          <ListBox Grid.Row="1" x:Name="ListLibs" Style="{StaticResource DarkList}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource DarkListItem}"/>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </Grid>

        <!-- Bottom buttons -->
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
          <Button Content="🔄 Refresh"          Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnRefreshLib_Click"/>
          <Button Content="▶ Start Steam"       Style="{StaticResource GreenBtn}"     Margin="0,0,8,0" Click="BtnStartSteam_Click"/>
          <Button Content="⏹ Kill Steam"        Style="{StaticResource DangerBtn}"    Margin="0,0,8,0" Click="BtnKillSteam_Click"/>
          <Button Content="🔁 Restart Steam"    Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnRestartSteam_Click"/>
          <Button Content="🔍 Diagnose"         Style="{StaticResource BlueBtn}"      Margin="0,0,8,0" Click="BtnDiagnose_Click"/>
          <Button Content="🧹 Clean ACF files"  Style="{StaticResource DangerBtn}"    Click="BtnCleanAcf_Click"/>
        </WrapPanel>
      </Grid>

      <!-- ╔══════════════════════════════════════════════╗ -->
      <!-- ║  MANUAL TOOLS PAGE                          ║ -->
      <!-- ╚══════════════════════════════════════════════╝ -->
      <ScrollViewer x:Name="PageTools" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="700">
          <TextBlock Text="Manual Tools" FontSize="22" FontWeight="Bold"
                     Foreground="#E0E0F0" Margin="0,0,0,20"/>

          <!-- Inject ACF section -->
          <TextBlock Text="INJECT ACF MANIFEST" FontSize="10" FontWeight="Bold" Foreground="#44445A" Margin="0,0,0,8"/>
          <TextBlock Text="AppID" FontSize="12" Foreground="#888899" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtToolAppId" Style="{StaticResource DarkTxt}" Margin="0,0,0,8"/>
          <TextBlock Text="Game Name" FontSize="12" Foreground="#888899" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtToolName"  Style="{StaticResource DarkTxt}" Margin="0,0,0,8"/>
          <TextBlock Text="Target Library Folder" FontSize="12" Foreground="#888899" Margin="0,0,0,4"/>
          <ComboBox x:Name="CmbToolLib" Style="{StaticResource DarkCombo}" Margin="0,0,0,16"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="💉 Inject ACF"           Style="{StaticResource PrimaryBtn}" Height="36" Click="BtnInjectAcf_Click"     Margin="0,0,8,0"/>
            <Button Content="🌙 Write Lua Script"     Style="{StaticResource BlueBtn}"    Height="36" Click="BtnWriteLua_Click"      Margin="0,0,8,0"/>
            <Button Content="🗑 Remove ACF"            Style="{StaticResource DangerBtn}"  Height="36" Click="BtnRemoveAcf_Click"/>
          </StackPanel>
          <Border Background="#181820" CornerRadius="6" Padding="12">
            <TextBox x:Name="TxtToolResult" IsReadOnly="True" Background="Transparent"
                     Foreground="#00CEC9" BorderThickness="0" FontFamily="Consolas"
                     FontSize="12" TextWrapping="Wrap" Height="70"/>
          </Border>

          <Separator Background="#1E1E30" Margin="0,20,0,20"/>

          <!-- Lua generator section -->
          <TextBlock Text="LUA CONFIG GENERATOR" FontSize="10" FontWeight="Bold" Foreground="#44445A" Margin="0,0,0,8"/>
          <TextBlock Text="AppID" FontSize="12" Foreground="#888899" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtLuaAppId"  Style="{StaticResource DarkTxt}" Margin="0,0,0,8"/>
          <TextBlock Text="Game Name" FontSize="12" Foreground="#888899" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtLuaName"   Style="{StaticResource DarkTxt}" Margin="0,0,0,8"/>
          <TextBlock Text="Depot IDs (comma-separated, optional)" FontSize="12" Foreground="#888899" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtLuaDepots" Style="{StaticResource DarkTxt}" Margin="0,0,0,8"/>
          <TextBlock Text="Output Folder" FontSize="12" Foreground="#888899" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="TxtLuaDir" Style="{StaticResource DarkTxt}"/>
            <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="BtnBrowseLua_Click"/>
          </Grid>
          <Button Content="🌙 Generate &amp; Save Lua" Style="{StaticResource BlueBtn}"
                  Width="200" HorizontalAlignment="Left" Height="36" Click="BtnGenLua_Click"/>
          <Border Margin="0,12,0,0" Background="#111118" CornerRadius="6" Padding="12">
            <TextBox x:Name="TxtLuaPreview" IsReadOnly="True" Background="Transparent"
                     Foreground="#00CEC9" BorderThickness="0" FontFamily="Consolas"
                     FontSize="12" TextWrapping="Wrap" Height="180"/>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ╔══════════════════════════════════════════════╗ -->
      <!-- ║  LOG PAGE                                   ║ -->
      <!-- ╚══════════════════════════════════════════════╝ -->
      <Grid x:Name="PageLog" Visibility="Collapsed" Margin="24,20,24,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Log Terminal" FontSize="22" FontWeight="Bold"
                   Foreground="#E0E0F0" Margin="0,0,0,14"/>
        <Border Grid.Row="1" Background="#08080E" CornerRadius="8"
                BorderBrush="#1A1A2A" BorderThickness="1">
          <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Padding="4">
            <TextBox x:Name="TxtLog" IsReadOnly="True" Background="Transparent"
                     Foreground="#00CEC9" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
          </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="🗑 Clear Log" Style="{StaticResource SecondaryBtn}" Click="BtnClearLog_Click"/>
        </StackPanel>
      </Grid>

      <!-- ╔══════════════════════════════════════════════╗ -->
      <!-- ║  SETTINGS PAGE                              ║ -->
      <!-- ╚══════════════════════════════════════════════╝ -->
      <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="640">
          <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"
                     Foreground="#E0E0F0" Margin="0,0,0,20"/>

          <!-- Steam Path -->
          <TextBlock Text="STEAM" FontSize="9" FontWeight="Bold" Foreground="#44445A" Margin="0,0,0,8"/>
          <TextBlock Text="Steam Path" FontSize="12" Foreground="#888899" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSteamPath" Style="{StaticResource DarkTxt}"/>
            <Button Grid.Column="1" Content="Browse"      Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="BtnBrowseSteam_Click"/>
            <Button Grid.Column="2" Content="Auto-Detect" Style="{StaticResource PrimaryBtn}"    Margin="8,0,0,0" Click="BtnAutoDetect_Click"/>
          </Grid>
          <TextBlock x:Name="TxtSteamDetectStatus" Text="" FontSize="11"
                     Foreground="#00B894" Margin="0,2,0,16"/>

          <!-- stplug-in dir -->
          <TextBlock Text="stplug-in Scripts Folder" FontSize="12" Foreground="#888899" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="TxtStplugDir" Style="{StaticResource DarkTxt}"/>
            <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="BtnBrowseStplug_Click"/>
          </Grid>
          <TextBlock Text="Default: Steam\config\stplug-in" FontSize="10"
                     Foreground="#44445A" Margin="0,2,0,20"/>

          <!-- Backend section -->
          <TextBlock Text="BACKEND" FontSize="9" FontWeight="Bold" Foreground="#44445A" Margin="0,0,0,8"/>
          <TextBlock Text="SteamAutoCrack Path (SteamAutoCrack.exe)" FontSize="12" Foreground="#888899" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtBackendPath" Style="{StaticResource DarkTxt}"/>
            <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="BtnBrowseBackend_Click"/>
            <Button Grid.Column="2" Content="Auto-Find" Style="{StaticResource BlueBtn}"  Margin="8,0,0,0" Click="BtnAutoFindBackend_Click"/>
          </Grid>
          <TextBlock Text="Backend Port" FontSize="12" Foreground="#888899" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtBackendPort" Style="{StaticResource DarkTxt}" Text="3000"/>
            <Button Grid.Column="1" Content="🔍 Scan" Style="{StaticResource SecondaryBtn}"
                    Margin="8,0,0,0" Click="BtnScanPorts_Click"/>
          </Grid>
          <TextBlock x:Name="TxtPortStatus" Text="" FontSize="11" Foreground="#00B894" Margin="0,2,0,20"/>

          <!-- App list source -->
          <TextBlock Text="GAME DATABASE" FontSize="9" FontWeight="Bold" Foreground="#44445A" Margin="0,0,0,8"/>
          <TextBlock Text="steam-applist.json Location (optional override)" FontSize="12" Foreground="#888899" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtAppListPath" Style="{StaticResource DarkTxt}"/>
            <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="BtnBrowseAppList_Click"/>
          </Grid>
          <TextBlock x:Name="TxtDbStatus" Text="" FontSize="11" Foreground="#666688" Margin="0,2,0,20"/>

          <!-- Save -->
          <Button Content="💾  Save Settings" Style="{StaticResource GreenBtn}"
                  Width="180" HorizontalAlignment="Left" Height="38"
                  FontSize="13" Click="BtnSaveSettings_Click"/>
          <TextBlock x:Name="TxtSaveStatus" Text="" FontSize="12" Foreground="#00B894" Margin="0,8,0,0"/>

          <!-- Guide -->
          <Border Margin="0,24,0,0" Background="#181820" CornerRadius="8" Padding="16">
            <StackPanel>
              <TextBlock Text="How it works" FontSize="14" FontWeight="SemiBold"
                         Foreground="#6C5CE7" Margin="0,0,0,10"/>
              <TextBlock TextWrapping="Wrap" Foreground="#888899" FontSize="12" LineHeight="22">
                <Run FontWeight="Bold" Foreground="#E0E0F0">For 'Install' button (recommended):</Run>&#10;
                1. Install Millennium (millennium.web.app) + stplug-in plugin&#10;
                2. Set Steam path here → Save&#10;
                3. Go to Add Games → search → click +Add&#10;
                4. Start Steam with Millennium active ✓&#10;&#10;
                <Run FontWeight="Bold" Foreground="#E0E0F0">Backend required for online sources (Luie/Ryuu/Sadie):</Run>&#10;
                Run SteamAutoCrack.exe — it provides the HTTP API&#10;
                The app connects to it at 127.0.0.1:PORT&#10;&#10;
                <Run FontWeight="Bold" Foreground="#E0E0F0">Manual Lua (no backend):</Run>&#10;
                Use Manual Tools page to write stplug-in lua files directly.
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Grid>
</Window>
