--!strict
-- Units.spec: conversion acceptance values. -- spec [28], [482]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Units = require(ReplicatedStorage.Shared.Units)
local TestKit = require(script.Parent.TestKit)

return function(t: TestKit.Api)
	t.describe("conversions", function()
		t.it("kmhToStudsPerSec(75) = 74.405", function()
			t.expect(Units.kmhToStudsPerSec(75)).toBeNear(74.405, 0.01)
		end)
		t.it("100 km/h = 99.21 studs/s", function()
			t.expect(Units.kmhToStudsPerSec(100)).toBeNear(99.21, 0.01)
		end)
		t.it("kgToRMU(56) = 2.551", function()
			t.expect(Units.kgToRMU(56)).toBeNear(2.551, 0.01)
		end)
		t.it("RMU_KG kilograms = 1 RMU", function()
			t.expect(Units.kgToRMU(Units.RMU_KG)).toBeNear(1, 1e-9)
		end)
		t.it("newtonsToRobloxForce(1000) = 162.69", function()
			t.expect(Units.newtonsToRobloxForce(1000)).toBeNear(162.69, 0.01)
		end)
		t.it("nmToRobloxTorque(100) = 58.10", function()
			t.expect(Units.nmToRobloxTorque(100)).toBeNear(58.10, 0.01)
		end)
		t.it("1,260 mm wheelbase = 4.50 studs", function()
			t.expect(Units.mmToStuds(1260)).toBeNear(4.50, 0.005)
		end)
		t.it("round-trips km/h", function()
			t.expect(Units.studsPerSecToKmh(Units.kmhToStudsPerSec(123))).toBeNear(123, 1e-9)
		end)
		t.it("MPH_TO_SPS = 1.59657", function()
			t.expect(Units.MPH_TO_SPS).toBeNear(1.59657, 1e-4)
		end)
	end)
end
