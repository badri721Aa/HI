# Copy this file to .env and edit it.

# ---- Which number the bot uses ----
# The bot links to a WhatsApp account like WhatsApp Web does. That can be YOUR OWN number —
# you don't need a new one. Leave PHONE_NUMBER empty to link by scanning a QR code,
# or put your number here (digits only, with country code) to get a pairing code instead.
PHONE_NUMBER=

# Who can use commands:
#   public — everyone in your groups (default)
#   self   — only you (good if you're running it on your personal number)
# You can switch later from WhatsApp with !mode public / !mode self
BOT_MODE=public

# Extra people allowed to use owner commands (digits only, comma-separated).
# The linked account is always an owner.
OWNER_NUMBERS=

# ---- Behaviour ----
PREFIX=!
BOT_NAME=BOT

# Put a "🤖 BOT" header on every bot message (recommended on your own number): on | off
BOT_LABEL=on

# Only respond in these groups (comma-separated). Send !id in a group to get its ID.
# Recommended when running on your personal number, so the bot stays out of other groups.
ALLOWED_GROUPS=

# Answer commands from anyone in private chats: on | off
ALLOW_DMS=off

# Defaults for new groups (admins can change them per group with !welcome, !antilink…)
WELCOME=on
ANTI_LINK=off
GROUP_RULES="1. Be respectful\n2. No spam\n3. Stay on topic"

# Troubleshooting: set to debug to see detailed connection logs
LOG_LEVEL=fatal
