# Copy to .env and edit.

# Command prefix
PREFIX=!

# Optional: log in with a pairing code instead of a QR code.
# Your bot's WhatsApp number, international format, digits only.
PHONE_NUMBER=

# Optional: only respond in these groups (comma-separated). Send !id in a group to get its ID.
ALLOWED_GROUPS=

# Welcome/goodbye messages: on | off
WELCOME=on

# Delete links posted by non-admins (bot must be admin): on | off
ANTI_LINK=off

# Shown by !rules. Use \n for new lines.
GROUP_RULES="1. Be respectful\n2. No spam\n3. Stay on topic"
